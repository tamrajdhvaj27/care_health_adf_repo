{
  "properties": {
    "activities": [
      {
        "type": "Lookup",
        "typeProperties": {
          "source": {
            "type": "FabricSqlDatabaseSource",
            "sqlReaderQuery": {
              "value": "select table_id\nfrom ctrl.table_config\nwhere is_active=1 and source_system = '@{pipeline().parameters.source_system}'",
              "type": "Expression"
            },
            "partitionOption": "None",
            "queryTimeout": "02:00:00"
          },
          "datasetSettings": {
            "type": "FabricSqlDatabaseTable",
            "schema": [],
            "connectionSettings": {
              "name": "HealthCareSQL_DB",
              "properties": {
                "type": "FabricSqlDatabase",
                "typeProperties": {
                  "artifactId": "510b9679-4975-acdc-46ba-bf47882058bb",
                  "workspaceId": "00000000-0000-0000-0000-000000000000"
                },
                "externalReferences": {
                  "connection": "1dd99050-a614-4983-88cd-4482346e9599"
                },
                "annotations": []
              }
            },
            "annotations": []
          },
          "firstRowOnly": false
        },
        "policy": {
          "timeout": "0.12:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureInput": false,
          "secureOutput": false
        },
        "name": "Read Source Tables List",
        "dependsOn": []
      },
      {
        "type": "ForEach",
        "typeProperties": {
          "isSequential": true,
          "items": {
            "value": "@activity('Read Source Tables List').output.value",
            "type": "Expression"
          },
          "activities": [
            {
              "type": "InvokePipeline",
              "typeProperties": {
                "parameters": {
                  "table_id": {
                    "value": "@item().table_id",
                    "type": "Expression"
                  },
                  "adf_run_id": {
                    "value": "@pipeline().parameters.adf_run_id",
                    "type": "Expression"
                  }
                },
                "waitOnCompletion": true,
                "workspaceId": "00000000-0000-0000-0000-000000000000",
                "pipelineId": "e10c708e-9048-a5cb-4335-c021355e6c02",
                "operationType": "InvokeFabricPipeline"
              },
              "externalReferences": {
                "connection": "28ef556d-5f9f-4922-9d98-46042b6113bb"
              },
              "policy": {
                "timeout": "0.12:00:00",
                "retry": 0,
                "retryIntervalInSeconds": 30,
                "secureInput": false,
                "secureOutput": false
              },
              "name": "Ingest from Source to Silver",
              "dependsOn": [
                {
                  "activity": "insert In Progess status",
                  "dependencyConditions": [
                    "Succeeded"
                  ]
                }
              ]
            },
            {
              "type": "Script",
              "typeProperties": {
                "scripts": [
                  {
                    "text": {
                      "value": "INSERT INTO [ctrl].[audit_log](\n       [adf_run_id] ,[table_id] ,[stage] ,[status]--,[records_written]\n       ,[start_time] -- ,[end_time],[created_timestamp]\n  ) \nVALUES('@{pipeline().parameters.adf_run_id}',@{item().table_id},'Source_to_Silver','IN_PROGRESS',SYSUTCDATETIME()\n)",
                      "type": "Expression"
                    },
                    "type": "Query"
                  }
                ],
                "scriptBlockExecutionTimeout": "02:00:00"
              },
              "connectionSettings": {
                "name": "HealthCareSQL_DB",
                "properties": {
                  "type": "FabricSqlDatabase",
                  "typeProperties": {
                    "artifactId": "510b9679-4975-acdc-46ba-bf47882058bb",
                    "workspaceId": "00000000-0000-0000-0000-000000000000"
                  },
                  "externalReferences": {
                    "connection": "1dd99050-a614-4983-88cd-4482346e9599"
                  },
                  "annotations": []
                }
              },
              "policy": {
                "timeout": "0.12:00:00",
                "retry": 2,
                "retryIntervalInSeconds": 30,
                "secureInput": false,
                "secureOutput": false
              },
              "name": "insert In Progess status",
              "dependsOn": []
            },
            {
              "type": "Script",
              "typeProperties": {
                "scripts": [
                  {
                    "text": {
                      "value": "UPDATE ctrl.audit_log\nSET status ='FAILED', end_time = SYSUTCDATETIME()\nWHERE adf_run_id = '@{pipeline().parameters.adf_run_id}' and table_id=@{item().table_id}",
                      "type": "Expression"
                    },
                    "type": "Query"
                  }
                ],
                "scriptBlockExecutionTimeout": "02:00:00"
              },
              "connectionSettings": {
                "name": "HealthCareSQL_DB",
                "properties": {
                  "type": "FabricSqlDatabase",
                  "typeProperties": {
                    "artifactId": "510b9679-4975-acdc-46ba-bf47882058bb",
                    "workspaceId": "00000000-0000-0000-0000-000000000000"
                  },
                  "externalReferences": {
                    "connection": "1dd99050-a614-4983-88cd-4482346e9599"
                  },
                  "annotations": []
                }
              },
              "policy": {
                "timeout": "0.12:00:00",
                "retry": 0,
                "retryIntervalInSeconds": 30,
                "secureInput": false,
                "secureOutput": false
              },
              "name": "Update Failed Status",
              "dependsOn": [
                {
                  "activity": "Ingest from Source to Silver",
                  "dependencyConditions": [
                    "Failed"
                  ]
                }
              ]
            }
          ]
        },
        "name": "Ingest All tables",
        "dependsOn": [
          {
            "activity": "Read Source Tables List",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ]
      }
    ],
    "parameters": {
      "source_system": {
        "type": "string",
        "defaultValue": "neon_postgres"
      },
      "adf_run_id": {
        "type": "string",
        "defaultValue": "b1"
      }
    }
  }
}